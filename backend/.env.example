# Kopieer naar backend/.env voor lokale ontwikkeling. Nooit committen.
DATABASE_URL=postgresql://community:community@localhost:5432/community
JWT_SECRET=lokaal-alleen-voor-ontwikkeling
APP_URL=http://localhost:4100
PORT=4100

# Optioneel — zonder SMTP_HOST worden mails in de console gelogd (links zijn dan te kopiëren).
# Mailgun (EU):  SMTP_HOST=smtp.eu.mailgun.org  SMTP_PORT=587  SMTP_USER=postmaster@mg.luzex.nl
# SendGrid:      SMTP_HOST=smtp.sendgrid.net    SMTP_PORT=587  SMTP_USER=apikey
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_WACHTWOORD=
# SMTP_AFZENDER=LuzeX Community <community@mail.luzex.nl>

# Admin-account (Job). Zonder deze waarden: admin@luzex.local / wijzig-dit-meteen
# SEED_ADMIN_EMAIL=job@luzex.nl
# SEED_ADMIN_WACHTWOORD=
# SEED_ADMIN_NAAM=Job
